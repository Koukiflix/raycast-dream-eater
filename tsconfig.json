{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "react"]
  },
  "include": ["src", "tests", "raycast-env.d.ts"]
}
